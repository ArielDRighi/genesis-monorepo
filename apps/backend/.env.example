# ===========================================
# GENESIS Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the required values
# All REQUIRED variables must be set for the application to start

# ===========================================
# Application Configuration
# ===========================================

# Environment: development | production | test
# REQUIRED: Yes (default: development)
NODE_ENV=development

# Application port
# REQUIRED: No (default: 3000)
PORT=3000

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL database connection settings

# Database host address
# REQUIRED: Yes
DATABASE_HOST=localhost

# Database port
# REQUIRED: No (default: 5432)
DATABASE_PORT=5434

# Database user
# REQUIRED: Yes
DATABASE_USER=postgres

# Database password
# REQUIRED: Yes
# WARNING: Use a strong password in production!
DATABASE_PASSWORD=postgres

# Database name
# REQUIRED: Yes
DATABASE_NAME=genesis_db

# ===========================================
# Docker PostgreSQL Configuration
# ===========================================
# Used by docker-compose.yml (mirrors DATABASE_* vars)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=genesis_db

# ===========================================
# JWT Authentication Configuration
# ===========================================

# JWT secret key for token signing
# REQUIRED: Yes
# MINIMUM LENGTH: 32 characters
# IMPORTANT: Generate a secure random string for production!
# Example generation: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-CHANGE-THIS-IN-PRODUCTION

# JWT token expiration time
# REQUIRED: No (default: 7d)
# Examples: '60s', '2h', '7d', '30d'
JWT_EXPIRATION=7d

# ===========================================
# AI Configuration (Optional)
# ===========================================

# Anthropic API key for AI features
# REQUIRED: No (optional in development)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===========================================
# Billing Configuration (Optional)
# ===========================================

# Stripe public key (client-side)
# REQUIRED: No
# Get your keys at: https://dashboard.stripe.com/apikeys
# STRIPE_PUBLIC_KEY=pk_test_your-public-key-here

# Stripe secret key (server-side)
# REQUIRED: No
# STRIPE_SECRET_KEY=sk_test_your-secret-key-here

# Stripe webhook secret for event verification
# REQUIRED: No
# Get from: https://dashboard.stripe.com/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ===========================================
# CORS Configuration
# ===========================================

# Frontend URL for CORS configuration
# REQUIRED: No (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# ===========================================
# Testing Environment (.env.test)
# ===========================================
# For E2E testing, create a .env.test file with:
#
# NODE_ENV=test
# PORT=3001
# DATABASE_HOST=localhost
# DATABASE_PORT=5438
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=genesis_testing_db
# JWT_SECRET=test-secret-key-with-at-least-32-characters-for-testing
# JWT_EXPIRATION=1h
# FRONTEND_URL=http://localhost:3000

