# Database Configuration (Development)
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=genesis_db

# Docker PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=genesis_db

# Application
NODE_ENV=development
PORT=3000

# ===========================================
# For E2E Testing, create a .env.test file with:
# ===========================================
# DB_HOST=localhost
# DB_PORT=5438
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=genesis_testing_db
# NODE_ENV=test
# PORT=3001
